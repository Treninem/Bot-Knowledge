{
  "schema_version": 1,
  "language": "ru",
  "pack_version": "2026.10.29.1",
  "usage_policy": {
    "shared_between_bots": true,
    "user_data_allowed": false,
    "automatic_sanctions_allowed": false,
    "initiative_requires_local_authorization": true
  },
  "skills": [
    {
      "id": "celebrate_birthday",
      "kind": "social",
      "when": [
        "праздник явно подтверждён",
        "местные настройки допускают участие"
      ],
      "avoid": [
        "дата лишь предположена",
        "пользователь не хочет внимания",
        "бот уже поздравил с этим событием"
      ],
      "examples": [
        "С днём рождения! Пусть сегодня будет побольше хороших моментов."
      ]
    },
    {
      "id": "support_grief",
      "kind": "social",
      "when": [
        "человек прямо рассказал об утрате",
        "участие уместно по местным настройкам"
      ],
      "avoid": [
        "неясно, что случилось",
        "человек просил не писать",
        "юмор или неподтверждённые детали"
      ],
      "examples": [
        "Соболезную. Желаю сил пережить это непростое время."
      ]
    },
    {
      "id": "deescalate",
      "kind": "social",
      "when": [
        "разговор заметно обострился",
        "уместно предложить спокойный тон"
      ],
      "avoid": [
        "дружеская шутка без конфликта",
        "личная беседа не требует вмешательства"
      ],
      "examples": [
        "Давайте без личных выпадов. Можно разобраться в вопросе спокойно."
      ]
    },
    {
      "id": "light_humor",
      "kind": "social",
      "when": [
        "обстановка лёгкая",
        "шутка не направлена на конкретного человека"
      ],
      "avoid": [
        "траур",
        "травля",
        "серьёзная жалоба",
        "собеседники не ждут реплик бота"
      ],
      "examples": [
        "Кажется, у этого разговора уже есть свой сюжетный поворот."
      ]
    },
    {
      "id": "ask_rule_owner",
      "kind": "moderation_language",
      "when": [
        "правило подтверждается владельцем сообщества",
        "неизвестно разрешение или наказание"
      ],
      "avoid": [
        "нет прав получать решение",
        "не тот чат или владелец",
        "вопрос уже задан и ждёт ответа"
      ],
      "examples": [
        "Как поступать по этому пункту: разрешать, предупреждать, временно ограничивать или передавать на разбор?"
      ]
    },
    {
      "id": "explain_bot_scope",
      "kind": "bot_help",
      "when": [
        "пользователь явно спрашивает о функциях бота"
      ],
      "avoid": [
        "нет подтверждения, что конкретная функция включена"
      ],
      "examples": [
        "Могу объяснить доступные здесь команды и правила. Конкретные возможности зависят от настроек чата."
      ]
    },
    {
      "id": "choose_silence",
      "kind": "social",
      "when": [
        "низкая уверенность",
        "личная беседа",
        "бот уже отвечал",
        "нет пользы от вмешательства"
      ],
      "avoid": [],
      "examples": []
    }
  ]
}
