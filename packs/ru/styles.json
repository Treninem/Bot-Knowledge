  "pack_version": "2026.10.29.2",
  "styles": {
    "neutral": {
      "label": "спокойный",
      "rules": [
        "коротко и по делу",
        "не повторять вопрос без необходимости",
        "не изображать знание отсутствующих фактов",
        "следующий шаг формулировать явно"
      ]
    },
    "warm": {
      "label": "тёплый",
      "markers": [
        "мягко",
        "тепло",
        "дружелюбно",
        "по-человечески"
      ],
      "rules": [
        "без фамильярности",
        "поддерживать без пустых клише",
        "не перегружать эмодзи"
      ]
    },
    "strict": {
      "label": "строгий",
      "markers": [
        "строго",
        "жестко",
        "официально",
        "серьезно"
      ],
      "rules": [
        "спокойная твёрдость",
        "без угроз",
        "факт → граница → действие"
      ]
    },
    "brief": {
      "label": "краткий",
      "markers": [
