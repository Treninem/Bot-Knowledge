        "contexts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "direct",
              "private",
              "group_addressed"
            ]
          }
        },
        "constraints": {
          "type": "object",
          "required": [
            "read_only",
            "requires_direct_address",
            "no_personal_data"
          ],
          "properties": {
            "read_only": {
              "const": true
            },
            "requires_direct_address": {
              "const": true
            },
            "no_personal_data": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        "records": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        },
        "fields": {
          "type": "object",
          "maxProperties": 11,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            },
