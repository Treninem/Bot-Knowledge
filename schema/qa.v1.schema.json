{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Treninem/Bot-Knowledge/main/schema/qa.v1.schema.json",
  "title": "Bot-Knowledge qa.v1 embedded catalog pack",
  "description": "Canonical embedded-catalog shape. Safe alternate fields/collection names additionally require scripts/validate_qa_v1.py; it enforces cross-field scopes, duplicate IDs, rendered limits, privacy markers and URL safety.",
  "type": "object",
  "required": [
    "schema_version",
    "catalog"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "language": {
      "enum": [
        "ru",
        "en",
        "multilingual"
      ]
    },
    "pack_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "\\S"
    },
    "catalog": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "title",
        "description",
        "purpose",
        "language",
        "adapter",
        "constraints"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700,
          "pattern": "\\S"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "language": {
          "enum": [
            "ru",
            "en",
            "multilingual"
          ]
        },
        "adapter": {
          "const": "qa.v1"
        },
        "tags": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          }
        },
        "audiences": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          },
          "minItems": 1
