                  "maxLength": 500,
                  "pattern": "^https://"
                },
                "audiences": {
                  "type": "array",
                  "maxItems": 12,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "\\S"
                  },
                  "minItems": 1
                },
                "contexts": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 3,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "direct",
                      "private",
                      "group_addressed"
                    ]
                  }
                },
                "constraints": {
                  "type": "object",
                  "required": [
                    "read_only",
                    "requires_direct_address",
                    "no_personal_data"
                  ],
                  "properties": {
                    "read_only": {
                      "const": true
                    },
                    "requires_direct_address": {
                      "const": true
                    },
                    "no_personal_data": {
                      "const": true
                    }
                  },
                  "additionalProperties": false
                },
                "language": {
                  "enum": [
                    "ru",
                    "en",
                    "multilingual"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
