{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bot-Knowledge manifest",
  "type": "object",
  "required": [
    "schema_version",
    "knowledge_version",
    "language",
    "packs"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "knowledge_version": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
